import time
from functools import lru_cache

count = 0

def normal(n):
    global count
    count += 1
    if n <= 1:
        return 1
    return normal(n-1) + normal(n-2)

@lru_cache(None)
def optimized(n):
    if n <= 1:
        return 1
    return optimized(n-1) + optimized(n-2)

n = 25

start = time.perf_counter()
count = 0
a = normal(n)
t1 = time.perf_counter() - start

start = time.perf_counter()
b = optimized(n)
t2 = time.perf_counter() - start

print("Normal Recursion:", a)
print("Function Calls:", count)
print("Time:", t1)

print("\nOptimized Recursion:", b)
print("Function Calls:", optimized.cache_info().misses)
print("Time:", t2)

print("\nResults Equal:", a == b)
