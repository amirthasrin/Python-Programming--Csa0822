import time

def build_plus(n):
    s = ""
    for i in range(n):
        s += f"Line {i}: Python Programming\n"
    return s

def build_join(n):
    lines = [f"Line {i}: Python Programming\n" for i in range(n)]
    return "".join(lines)

def build_fstring(n):
    return "".join(f"Line {i}: Python Programming\n" for i in range(n))

for n in (1000, 10000, 200000):
    start = time.perf_counter()
    a = build_plus(n)
    t1 = time.perf_counter() - start

    start = time.perf_counter()
    b = build_join(n)
    t2 = time.perf_counter() - start

    start = time.perf_counter()
    c = build_fstring(n)
    t3 = time.perf_counter() - start

    print("\nLines:", n)
    print("Plus time:", t1)
    print("Join time:", t2)
    print("F-string time:", t3)
    print("Equal:", a == b == c)
    print("Length:", len(a))
