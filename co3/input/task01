import random

readings = [random.randint(0, 20) for i in range(365)]

weekly = [sum(readings[i:i+7]) for i in range(0, 365, 7)]

print("Weekly totals:", weekly)
print("Maximum:", max(readings))
print("Minimum:", min(readings))

avg = [sum(readings[i:i+7])/7 for i in range(359)]
print("Moving average:", avg)

print("Dry days:", [i+1 for i, x in enumerate(readings) if x == 0])
